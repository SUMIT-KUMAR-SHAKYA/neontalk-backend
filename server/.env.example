# ─── Neontalk Server Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in real values before running.

# MongoDB Atlas M0 free cluster connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/neontalk?retryWrites=true&w=majority

# Port the server listens on (Render sets this automatically)
PORT=4000

# Comma-separated list of allowed frontend origins (e.g. your Vercel URL)
CLIENT_ORIGIN=http://localhost:5173,https://neontalk.vercel.app

# Metered.ca free TURN credentials (get from https://www.metered.ca/tools/openrelay)
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject
